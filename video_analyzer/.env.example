# Your gateway key (used for chat/vision models such as (paid) gpt-4o-mini — not for whisper-1).
OPENAI_API_KEY=sk..

# Pubmatic / OpenAI-compatible API base (required if you do not use api.openai.com).
OPENAI_BASE_URL=https://llm.pubmatic.com

# Transcription runs locally (Hugging Face). Your API key is never used for whisper-1.
# VIDEO_ANALYZER_HF_TRANSCRIPTION_MODEL=distil-whisper/distil-small.en
# VIDEO_ANALYZER_HF_CHUNK_LENGTH_SEC=30
# VIDEO_ANALYZER_HF_ASR_BATCH_SIZE=8
# Do not set VIDEO_ANALYZER_TRANSCRIPTION_BACKEND=openai (removed; whisper-1 not supported on this gateway).

# Max bytes when downloading a video from an http(s) URL (default 500 MiB).
# VIDEO_ANALYZER_MAX_DOWNLOAD_BYTES=524288000

# Vision + summary — must match names your key can use, e.g. (paid) gpt-4o-mini
# VIDEO_ANALYZER_VISION_MODEL=(paid) gpt-4o-mini
# VIDEO_ANALYZER_SUMMARY_MODEL=(paid) gpt-4o-mini
# VIDEO_ANALYZER_FRAME_INTERVAL_SEC=15
# VIDEO_ANALYZER_MAX_FRAMES=24
# VIDEO_ANALYZER_VISION_BATCH_SIZE=8
